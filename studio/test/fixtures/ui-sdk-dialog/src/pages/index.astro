---
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <title>Project overview</title>
    <meta name="description" content="An overview of the project." />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <main>
      <h1>Project overview</h1>
      <p>The project is open for review.</p>
      <a href="https://example.test/about">About the project</a>
    </main>
  </body>
</html>
